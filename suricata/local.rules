# Our own lab rules (sid 1000000+). They are added to the ET Open rule set.
# Each rule counts new connections (TCP SYN packets) from ONE source in a time window.
# "type both" = alert once per window when the count is reached.

# Scenario 1 - port scan: many SYNs to ports the victim does not normally serve
alert tcp any any -> $HOME_NET ![22,80] (msg:"LAB SCAN Many SYNs to unused ports from one source"; flags:S,CE; threshold: type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# Scenario 2 - SSH password guessing: many new SSH connections from one source
alert tcp any any -> $HOME_NET 22 (msg:"LAB BRUTEFORCE Many new SSH connections from one source"; flags:S,CE; threshold: type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000002; rev:1;)

# Scenario 3 - DoS: SYN flood against the web server
alert tcp any any -> $HOME_NET 80 (msg:"LAB DOS SYN flood to web server"; flags:S,CE; threshold: type both, track by_src, count 200, seconds 5; classtype:attempted-dos; sid:1000003; rev:1;)
